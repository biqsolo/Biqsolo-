<!-- JavaScript Logic -->
<script>
    // Theme Toggle Function
    function toggleDarkMode() {
        document.documentElement.classList.toggle('dark');
    }

    // Mobile Menu Toggle
    function toggleMobileMenu() {
        const menu = document.getElementById('mobileMenu');
        menu.classList.toggle('hidden');
    }

    // Calculate Total Cost
    let currentCalculatedTotal = 0;
    let selectedServiceNames = [];

    function calculateTotal() {
        const checkboxes = document.querySelectorAll('.service-checkbox');
        const expressCheckbox = document.getElementById('expressDelivery');
        
        let total = 0;
        selectedServiceNames = [];

        checkboxes.forEach(cb => {
            if (cb.checked) {
                total += parseInt(cb.value);
                selectedServiceNames.push(cb.getAttribute('data-name'));
            }
        });

        if (expressCheckbox.checked) {
            total += parseInt(expressCheckbox.value);
            selectedServiceNames.push('24-Hr Express Delivery');
        }

        currentCalculatedTotal = total;
        const formattedTotal = '₦' + total.toLocaleString();
        document.getElementById('totalDisplay').innerText = formattedTotal;
        document.getElementById('modalTotalDisplay').innerText = formattedTotal;
        
        const servicesListText = selectedServiceNames.length > 0 ? selectedServiceNames.join(', ') : 'No services selected';
        document.getElementById('modalSelectedServices').innerText = servicesListText;
    }

    // Modal Controls
    function openCheckoutModal() {
        if (currentCalculatedTotal <= 0) {
            alert('Please select at least one service from the calculator before proceeding.');
            return;
        }
        document.getElementById('checkoutModal').classList.remove('hidden');
    }

    function closeCheckoutModal() {
        document.getElementById('checkoutModal').classList.add('hidden');
    }

    // Payment Tab Switcher
    function switchPaymentTab(tab) {
        const btnPaystack = document.getElementById('tabPaystack');
        const btnTransfer = document.getElementById('tabTransfer');
        const secPaystack = document.getElementById('sectionPaystack');
        const secTransfer = document.getElementById('sectionTransfer');

        if (tab === 'paystack') {
            btnPaystack.className = "py-3 px-4 rounded-xl font-bold text-sm border-2 border-brand-600 bg-brand-50 dark:bg-brand-950/40 text-brand-600 transition flex items-center justify-center gap-2";
            btnTransfer.className = "py-3 px-4 rounded-xl font-bold text-sm border-2 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 transition flex items-center justify-center gap-2";
            secPaystack.classList.remove('hidden');
            secTransfer.classList.add('hidden');
        } else {
            btnTransfer.className = "py-3 px-4 rounded-xl font-bold text-sm border-2 border-brand-600 bg-brand-50 dark:bg-brand-950/40 text-brand-600 transition flex items-center justify-center gap-2";
            btnPaystack.className = "py-3 px-4 rounded-xl font-bold text-sm border-2 border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 transition flex items-center justify-center gap-2";
            secTransfer.classList.remove('hidden');
            secPaystack.classList.add('hidden');
        }
    }

    // Copy Account Number Function
    function copyAccountNumber() {
        const accNum = document.getElementById('accountNumberText').innerText;
        navigator.clipboard.writeText(accNum);
        alert('Account number copied to clipboard: ' + accNum);
    }

    // WhatsApp Transfer Confirmation
    function confirmBankTransfer() {
        const name = document.getElementById('clientName').value || 'Customer';
        const phone = document.getElementById('clientPhone').value || 'Not provided';
        const services = selectedServiceNames.join(', ');
        const total = '₦' + currentCalculatedTotal.toLocaleString();

        const message = `Hello ApexDigital, I just made a direct bank transfer.\n\nName: ${name}\nPhone: ${phone}\nServices: ${services}\nTotal Amount: ${total}\n\nHere is my receipt:`;
        const whatsappUrl = `https://wa.me/2348000000000?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
    }

    // Paystack Checkout Integration
    const PAYSTACK_PUBLIC_KEY = 'pk_test_xxxxxxxxxxxxxxxxxxxxxxxx'; // Replace with your live Paystack public key later

    function payWithPaystack() {
        const email = document.getElementById('clientEmail').value;
        const name = document.getElementById('clientName').value;
        const phone = document.getElementById('clientPhone').value;

        if (!email || !name) {
            alert('Please enter your Name and Email address to proceed with online payment.');
            return;
        }

        let handler = PaystackPop.setup({
            key: PAYSTACK_PUBLIC_KEY,
            email: email,
            amount: currentCalculatedTotal * 100, // Paystack expects amount in Kobo
            currency: 'NGN',
            metadata: {
                custom_fields: [
                    { display_name: "Customer Name", variable_name: "customer_name", value: name },
                    { display_name: "Phone Number", variable_name: "phone_number", value: phone },
                    { display_name: "Selected Services", variable_name: "services", value: selectedServiceNames.join(', ') }
                ]
            },
            callback: function(response) {
                alert('Payment successful! Reference: ' + response.reference);
                closeCheckoutModal();
                // Redirect or trigger success flow here
            },
            onClose: function() {
                alert('Payment window closed.');
            }
        });
        handler.openIframe();
    }
</script>
